# ─────────────────────────────────────────────────────────────────────────
# PUBLIC config — safe to expose to the browser (VITE_ prefix = bundled
# into client JS). These are NOT secrets: cloud name is just an account
# identifier, and the upload preset only allows *unsigned* uploads scoped
# to whatever rules you configure for it in the Cloudinary dashboard.
# ─────────────────────────────────────────────────────────────────────────
VITE_CLOUDINARY_CLOUD_NAME=demo
VITE_CLOUDINARY_UPLOAD_PRESET=img_ventory_upload
VITE_CLOUDINARY_FOLDER=img-ventory

# ─────────────────────────────────────────────────────────────────────────
# SERVER-ONLY secrets — DO NOT prefix with VITE_. These are only read by
# the serverless functions in api/ (api/images, api/images/bulk, api/folders,
# api/stats) and must never be sent to the browser. Anyone with the API Secret can
# list, read, and delete every asset in your Cloudinary account.
#
# Get these from your Cloudinary dashboard: Settings → Access Keys.
# On Vercel/Netlify, set them in the project's dashboard env var settings
# (NOT with a VITE_/NEXT_PUBLIC_/PUBLIC_ style prefix), so they stay
# server-side only.
# ─────────────────────────────────────────────────────────────────────────
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional, server-only. "dynamic" or "fixed" — your Cloudinary product
# environment's folder mode (Console → Settings → Product environment).
# When unset, the API asks Cloudinary's Admin API (GET /config) once per
# function instance. Move/rename refuse to run if the mode can't be determined.
# CLOUDINARY_FOLDER_MODE=dynamic
